# CJA Audit Log Monitor - Environment Variables
# Copy this file to .env and fill in your credentials
#
# SECURITY: Never commit .env to version control! It's already in .gitignore.

# ============================================================================
# Adobe OAuth Server-to-Server Credentials
# ============================================================================
#
# Prerequisites:
#   1. Access to Adobe Experience Cloud with CJA permissions
#   2. Access to Adobe Developer Console (https://developer.adobe.com/console)
#   3. System Administrator or Developer role for creating credentials
#
# IMPORTANT: Your project must have BOTH APIs configured:
#   - Customer Journey Analytics API
#   - Experience Platform API (required even for CJA-only usage)
#
# Setup Steps:
#   1. Go to https://developer.adobe.com/console
#   2. Verify correct organization in top-right dropdown
#   3. Create a new project (or open existing)
#   4. Click "Add API" → select "Customer Journey Analytics" → OAuth Server-to-Server
#   5. Click "Add API" again → select "Experience Platform API" → OAuth Server-to-Server
#   6. Both APIs share the same OAuth credentials
#   7. Copy credentials below from the "OAuth Server-to-Server" section
#
# For detailed setup guide and troubleshooting, see:
# https://developer.adobe.com/cja-apis/docs/getting-started/

# Organization ID
# Found in: Developer Console top-right user menu, or Project Overview
# Format: Must end with @AdobeOrg
ORG_ID="YOUR_ORG_ID@AdobeOrg"

# Client ID (also called API Key)
# Found in: Project > Credentials > OAuth Server-to-Server
CLIENT_ID="YOUR_CLIENT_ID"

# Client Secret
# Found in: Project > Credentials > OAuth Server-to-Server > "Retrieve client secret"
# NOTE: Regenerating the secret in Developer Console invalidates the old one
SECRET="YOUR_CLIENT_SECRET"

# OAuth Scopes
# Found in: Project > Credentials > OAuth Server-to-Server > Scopes
# IMPORTANT: Copy exactly as shown in Developer Console; incorrect scopes cause errors
# Default scopes for CJA read access:
SCOPES="openid,AdobeID,read_organizations,additional_info.projectedProductContext"
