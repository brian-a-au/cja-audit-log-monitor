# CJA Audit Log Monitor - Environment Variables
# Copy this file to .env and fill in your credentials

# Adobe OAuth Server-to-Server Credentials (Recommended)
CJA_CLIENT_ID=your_client_id_here
CJA_CLIENT_SECRET=your_client_secret_here
CJA_ORG_ID=your_organization_id@AdobeOrg

# OAuth Scopes (comma-separated, usually don't need to change)
CJA_SCOPES=openid,AdobeID,read_organizations,additional_info.projectedProductContext

# Optional: JWT Authentication (Legacy)
# CJA_TECH_ACCOUNT_ID=your_technical_account_id
# CJA_PRIVATE_KEY_PATH=/path/to/private.key

# Optional: Custom API endpoints (usually don't need to change)
# CJA_API_BASE_URL=https://cja.adobe.io
# CJA_IMS_BASE_URL=https://ims-na1.adobelogin.com

# Optional: Custom config file path
# CJA_CONFIG_PATH=~/.cja-audit/config.yaml
