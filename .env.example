# CJA Audit Log Monitor - Environment Variables
# Copy this file to .env and fill in your credentials

# Adobe OAuth Server-to-Server Credentials
# You can obtain these from the Adobe Developer Console (https://developer.adobe.com/console)
# 1. Create a new project or open an existing one.
# 2. Add "API" > "Customer Journey Analytics" (or relevant service).
# 3. Select "Server-to-Server" authentication.
# 4. Copy the credentials below.

# Organization ID (found in the top right user menu or in the credential details)
# Format: XXXXXXXXXXXXXXXXXXXXXXXX@AdobeOrg
ORG_ID="YOUR_ORG_ID@AdobeOrg"

# Client ID (API Key)
CLIENT_ID="YOUR_CLIENT_ID"

# Client Secret
CLIENT_SECRET="YOUR_CLIENT_SECRET"

# Scopes (comma-separated list of scopes required for the application)
# Ensure your integration has access to these scopes in the console.
# Default required scopes: openid, AdobeID, additional_info.projectedProductContext
SCOPES="openid,AdobeID,additional_info.projectedProductContext"