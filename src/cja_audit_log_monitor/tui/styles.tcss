/* CJA Audit Log Monitor — Modern TUI Styles
 * Toad-inspired: hairline dividers, soft tinted surfaces, breathing room.
 * Dark theme only.
 */

/* ---- Design tokens ---- */
$background: #0f1115;
$surface: rgba(255, 255, 255, 0.025);
$primary: #6db0d6;
$text-strong: #e8e8e8;
$text: #c8ccd4;
$text-muted: #6e7480;
$danger: #e07a7a;
$warning: #e8c547;
$success: #7fc896;

/* ---- Global ---- */
Screen {
    background: $background;
    color: $text;
}

/* ---- Top status row (replaces Header) ---- */
#status-row {
    dock: top;
    height: auto;  /* one line; wraps only when a config warning is long */
    min-height: 1;
    padding: 0 1;
    background: $background;
    color: $text-muted;
}

#status-row .status-dot-ok    { color: $success; }
#status-row .status-dot-warn  { color: $warning; }
#status-row .status-dot-down  { color: $danger; }

/* ---- Footer (toad treatment) ---- */
/* Textual 7.5+ renders each binding as a FooterKey widget with component
 * classes `footer-key--key` and `footer-key--description`. The default theme
 * colors the key chip amber; override to steel-blue to match the rest of the
 * design vocabulary. */
Footer {
    dock: bottom;
    height: 1;
    background: $background;
    color: $text-muted;
}

FooterKey {
    background: $background;
}

FooterKey > .footer-key--key {
    color: $primary;
    background: $background;
    text-style: none;
}

FooterKey > .footer-key--description {
    color: $text-muted;
    background: $background;
}

FooterKey:hover {
    background: $background;
    color: $primary;
}

/* ---- Sidebar ---- */
#sidebar {
    width: 22;
    dock: left;
    background: $background;
    border-right: solid rgba(255, 255, 255, 0.06);
    padding: 1 0;
}

#sidebar .nav-section-label {
    color: $text-muted;
    padding: 0 2;
    height: 1;
}

#sidebar .nav-item {
    width: 100%;
    height: 1;
    padding: 0 2;
    color: $text-muted;
    background: $background;
}

#sidebar .nav-item.active {
    color: $text-strong;
    background: $primary 8%;
    border-left: heavy $primary;
    padding: 0 1;        /* offset to compensate for the left border */
}

/* Narrow terminals (< 100 columns): the sidebar shows only the key letters. */
Screen.-narrow #sidebar {
    width: 5;
}

Screen.-narrow #sidebar .nav-section-label {
    display: none;
}

Screen.-narrow #sidebar .nav-item {
    padding: 0 1;
}

Screen.-narrow #sidebar .nav-item.active {
    padding: 0;
}

/* ---- Main content ---- */
#main-content {
    width: 1fr;
    height: 1fr;
    background: $background;
}

/* ---- Section labels (uppercase + muted, used inside screens) ---- */
.section-label {
    color: $text-muted;
    text-style: none;
    height: 1;
    margin: 1 0 0 0;
}

/* ---- Cards: one shared surface style ----
 * Accent edge uses `heavy` (box-drawing ┃) so it renders as a continuous line. */
.card,
.stat-card,
.settings-section,
.rule-card,
#monitor-status {
    height: auto;
    padding: 1 2;
    background: $surface;
    border-left: heavy $primary;
}

.card.-danger, .stat-card.severity-danger { border-left: heavy $danger; }
.card.-warning, .stat-card.severity-warning { border-left: heavy $warning; }
.card.-success, .stat-card.severity-success { border-left: heavy $success; }
.card.-muted { border-left: heavy #6e7480; }

/* Section labels that open a card sit on its first row. */
.settings-section > .section-label {
    margin: 0;
}

/* ---- Stat cards ---- */
.dashboard-stats {
    height: auto;
    margin: 1 0 0 0;
    padding: 0;
    background: $background;
}

.stat-card {
    width: 1fr;
    height: 5;
    margin: 0 1 0 0;
}

.stat-value {
    color: $text-strong;
    text-style: bold;
}

.stat-label {
    color: $text-muted;
}

/* ---- Log table ---- */
LogTable {
    height: 1fr;
    overflow-x: hidden;
    background: $background;
    color: $text;
}

LogTable > .datatable--header {
    background: $background;
    color: $text-muted;
    text-style: none;
    border-bottom: solid rgba(255, 255, 255, 0.06);
}

LogTable > .datatable--cursor {
    background: $primary 8%;
    color: $text-strong;
}

LogTable > .datatable--hover {
    background: $surface;
}

/* ---- Filter bar (single row, no panel background) ---- */
FilterBar {
    height: 2;
    dock: top;
    padding: 0 1;
    layout: horizontal;
    background: $background;
    border-bottom: solid rgba(255, 255, 255, 0.06);
}

FilterBar Horizontal {
    height: 1;
}

FilterBar #filter-text-row { width: 1fr; }
FilterBar #filter-select-row { width: auto; }

FilterBar Input {
    width: 1fr;
    margin: 0 1 0 0;
}

FilterBar #filter-user { width: 1fr; max-width: 32; }
FilterBar #filter-action { width: 14; }
FilterBar #filter-component { width: 18; }

FilterBar Select {
    margin: 0 1 0 0;
}

FilterBar Button {
    margin: 0;
}

/* Narrow terminals: two rows, search and user above the selects and reset. */
Screen.-narrow FilterBar {
    height: 3;
    layout: vertical;
}

Screen.-narrow FilterBar Horizontal {
    width: 100%;
}

Screen.-narrow FilterBar #filter-user { max-width: 100%; }
Screen.-narrow FilterBar #filter-action { width: 1fr; }
Screen.-narrow FilterBar #filter-component { width: 1fr; }


/* ---- Stats panel ---- */
.stats-row {
    height: auto;
    margin: 1 0 0 0;
}

.stats-column {
    width: 1fr;
    height: auto;
    margin: 0 2 0 0;
}

.bar-chart {
    height: auto;
    margin: 1 0;
}

AlertSummary {
    height: auto;
    padding: 0 2;
    background: $background;
    color: $text;
}

/* ---- Monitor screen ---- */
#monitor-controls {
    height: 1;
    margin: 1 0;
}

#monitor-status {
    height: 1;
    padding: 0 2;
    margin: 0 0 1 0;
}

#status-indicator {
    width: auto;
    margin: 0 2 0 0;
}

#stats-info {
    width: 1fr;
    color: $text-muted;
}

.monitor-running {
    border-left: heavy $success;
}

.monitor-stopped {
    border-left: heavy $danger;
}

#alert-summary {
    max-height: 8;
}

#monitor-log {
    height: 1fr;
    background: $background;
    border: none;
}

/* ---- Entry detail SIDE PANEL (was a modal) ---- */
#entry-detail-panel {
    dock: right;
    width: 40;
    height: 100%;
    padding: 1 2;
    background: $surface;
    border-left: solid rgba(255, 255, 255, 0.06);
    color: $text;
}

#entry-detail-panel.hidden {
    display: none;
}

/* Narrow terminals: the panel covers the table instead of squeezing it to nothing. */
Screen.-narrow #entry-detail-panel {
    width: 100%;
}

#entry-detail-panel .modal-title {
    color: $text-strong;
    text-style: bold;
    margin: 0 0 1 0;
}

/* ---- Log browser layout (table + side panel) ---- */
#log-browser-container {
    layout: vertical;
    height: 1fr;
    width: 1fr;
}

#log-table-and-panel {
    layout: horizontal;
    height: 1fr;
    width: 1fr;
}

/* ---- Export dialog (centered modal, same chrome as the views) ---- */
ExportDialog {
    align: center middle;
}

#export-box {
    width: 64;
    height: auto;
    padding: 1 2;
    background: $background;
    border-left: heavy $primary;
}

ExportDialog .modal-title {
    color: $text-strong;
    margin: 0 0 1 0;
}

ExportDialog .field-label {
    color: $text-muted;
    margin: 1 0 0 0;
}

ExportDialog RadioSet {
    width: 100%;
    height: auto;
    border: none;
    background: $background;
}

ExportDialog #format-select {
    layout: horizontal;
}

ExportDialog #format-select RadioButton {
    margin: 0 2 0 0;
}

ExportDialog Input {
    width: 100%;
    background: $surface;
}

ExportDialog .modal-buttons {
    height: auto;
    margin: 1 0 0 0;
}

ExportDialog .modal-buttons Button {
    margin: 0 1 0 0;
}

#export-status {
    height: auto;
    margin: 1 0 0 0;
}

/* ---- Settings ---- */
#settings-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1 2;
    height: auto;
    margin: 1 0 0 0;
}

.settings-section {
    margin: 0;
}

.settings-row {
    height: auto;
}

.settings-label {
    width: 22;
    color: $text-muted;
}

.settings-value {
    width: 1fr;
    color: $text;
}

/* ---- Alerts management ---- */
.rule-card {
    margin: 0 0 1 0;
    padding: 0 2;
    border-left: heavy #6e7480;
}

#rules-list {
    height: auto;
    margin: 1 0 0 0;
}

.rule-header {
    height: 1;
}

.rule-header Checkbox {
    width: auto;
    margin: 0 2 0 0;
}

.rule-description {
    width: 1fr;
}

.rule-card.rule-enabled {
    border-left: heavy $success;
}

.rule-card.rule-disabled {
    border-left: heavy #6e7480;
}

/* ---- Help overlay ---- */
HelpScreen {
    align: center middle;
}

#help-overlay {
    width: 56;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    background: $background;
    border-left: heavy $primary;
    overflow-y: auto;
}

#help-title {
    color: $text-strong;
}

.help-section {
    margin: 1 0 0 0;
}

.help-section-body {
    height: auto;
}

#help-footer {
    margin: 1 0 0 0;
}

/* ---- Toolbars: one-row control strips ---- */
.toolbar {
    height: 1;
    margin: 1 0;
}

.toolbar Button {
    margin: 0 1 0 0;
}

.toolbar Label, .toolbar Static {
    width: auto;
    margin: 0 1 0 0;
    color: $text-muted;
}

.toolbar Input {
    width: 8;
    margin: 0 1 0 0;
}

/* ---- Pagination ---- */
#pagination {
    height: 1;
    dock: bottom;
    padding: 0 1;
    background: $background;
}

#pagination Button {
    margin: 0 1;
}

#pagination Label, #pagination Static {
    width: auto;
    color: $text-muted;
    margin: 0 1 0 0;
}

/* ---- Loading indicator ----
 * Hidden until a view starts loading. Lives on an overlay layer, so showing
 * it never pushes the view's layout around. */
ContentView {
    layers: base overlay;
}

ContentView LoadingIndicator {
    display: none;
    layer: overlay;
    dock: top;
    height: 1;
    width: 100%;
    background: transparent;
    color: $primary;
}

/* ---- Empty state (no data / not connected) ---- */
.empty-state {
    display: none;
    height: auto;
    margin: 2 2;
    padding: 1 2;
    background: $surface;
    border-left: heavy $primary;
}

/* The body scrolls when a view is taller than the terminal. Logs and
 * monitor still fill the space because their tables are 1fr. */
#view-body {
    height: 1fr;
    overflow-y: auto;
}

#settings-container, #alerts-container, #stats-container {
    height: auto;
}

/* ---- Dashboard columns ---- */
#dash-columns {
    height: auto;
}

#dash-left {
    width: 2fr;
    height: auto;
    margin: 0 2 0 0;
}

#dash-right {
    width: 1fr;
    height: auto;
}

/* ---- Status indicators (used in dashboard/connection text) ---- */
.status-connected     { color: $success; }
.status-disconnected  { color: $danger; }
.status-warning       { color: $warning; }

/* Shown under the stat cards when charts use only the newest entries */
.sample-note {
    height: auto;
    margin: 0 0 1 0;
    color: $text-muted;
}
