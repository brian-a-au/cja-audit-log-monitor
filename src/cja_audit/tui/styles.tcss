/* CJA Audit Log Monitor — Modern TUI Styles
 * Toad-inspired: hairline dividers, soft tinted surfaces, breathing room.
 * Dark theme only.
 */

/* ---- Design tokens ---- */
$background: #0f1115;
$surface: rgba(255, 255, 255, 0.025);
$primary: #6db0d6;
$text-strong: #e8e8e8;
$text: #c8ccd4;
$text-muted: #6e7480;
$danger: #e07a7a;
$warning: #e8c547;
$success: #7fc896;

/* ---- Global ---- */
Screen {
    background: $background;
    color: $text;
}

/* ---- Top status row (replaces Header) ---- */
#status-row {
    dock: top;
    height: 1;
    padding: 0 1;
    background: $background;
    color: $text-muted;
}

#status-row .status-dot-ok    { color: $success; }
#status-row .status-dot-warn  { color: $warning; }
#status-row .status-dot-down  { color: $danger; }

/* ---- Footer (toad treatment) ---- */
Footer {
    dock: bottom;
    height: 1;
    background: $background;
    color: $text-muted;
}

Footer > .footer--key {
    color: $primary;
    background: $background;
    text-style: none;
}

Footer > .footer--description {
    color: $text-muted;
    background: $background;
}

Footer > .footer--highlight,
Footer > .footer--highlight-key {
    background: $background;
    color: $text;
}

/* ---- Sidebar ---- */
#sidebar {
    width: 22;
    dock: left;
    background: $background;
    border-right: solid rgba(255, 255, 255, 0.06);
    padding: 1 0;
}

#sidebar .nav-section-label {
    color: $text-muted;
    padding: 0 2;
    height: 1;
}

#sidebar .nav-item {
    width: 100%;
    height: 1;
    padding: 0 2;
    color: $text-muted;
    background: $background;
}

#sidebar .nav-item.active {
    color: $text-strong;
    background: $primary 8%;
    border-left: thick $primary;
    padding: 0 1;        /* offset to compensate for the left border */
}

/* ---- Main content ---- */
#main-content {
    width: 1fr;
    height: 1fr;
    background: $background;
}

/* ---- Section labels (uppercase + muted, used inside screens) ---- */
.section-label {
    color: $text-muted;
    text-style: none;
    height: 1;
    margin: 1 0 0 0;
}

/* ---- Stat cards ---- */
.dashboard-stats {
    height: auto;
    margin: 1 0 0 0;
    padding: 0;
    background: $background;
}

.stat-card {
    width: 1fr;
    height: auto;
    padding: 1 2;
    margin: 0 1 0 0;
    background: $surface;
    border-left: thick $primary;
}

.stat-card.severity-danger  { border-left: thick $danger; }
.stat-card.severity-warning { border-left: thick $warning; }
.stat-card.severity-success { border-left: thick $success; }

.stat-value {
    color: $text-strong;
    text-style: bold;
}

.stat-label {
    color: $text-muted;
}

/* ---- Log table ---- */
LogTable {
    height: 1fr;
    background: $background;
    color: $text;
}

LogTable > .datatable--header {
    background: $background;
    color: $text-muted;
    text-style: none;
    border-bottom: solid rgba(255, 255, 255, 0.06);
}

LogTable > .datatable--cursor {
    background: $primary 8%;
    color: $text-strong;
}

LogTable > .datatable--hover {
    background: $surface;
}

/* ---- Filter bar (single row, no panel background) ---- */
FilterBar {
    height: 3;
    dock: top;
    padding: 0 1;
    background: $background;
    border-bottom: solid rgba(255, 255, 255, 0.06);
}

FilterBar Horizontal {
    height: 3;
    align-vertical: middle;
}

FilterBar Input {
    width: 1fr;
    margin: 0 1 0 0;
    background: $surface;
    border: none;
    color: $text;
}

FilterBar Select {
    width: 18;
    margin: 0 1 0 0;
    background: $surface;
    border: none;
    color: $text;
}

FilterBar Button {
    margin: 0 1 0 0;
    background: $surface;
    color: $text;
    border: none;
    text-style: none;
}

FilterBar Button.-primary {
    color: $primary;
}

/* ---- Stats panel ---- */
StatsPanel {
    height: auto;
    padding: 1 2;
    margin: 1 0;
    background: $surface;
    border-left: thick $primary;
}

.stats-grid {
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
}

.stats-section {
    height: auto;
    padding: 0 2;
    margin: 1 1 1 0;
    background: $surface;
    border-left: thick $primary;
}

.bar-chart {
    height: auto;
    margin: 1 0;
}

/* ---- Alert card ---- */
AlertCard {
    height: auto;
    padding: 1 2;
    margin: 1 0;
    background: $surface;
    border-left: thick $danger;
}

AlertCard .alert-title {
    color: $danger;
    text-style: bold;
}

AlertCard .alert-message {
    color: $text;
}

AlertSummary {
    height: auto;
    padding: 0 2;
    background: $background;
    color: $text;
}

/* ---- Monitor screen ---- */
#monitor-controls {
    height: auto;
    dock: top;
    padding: 0 1;
    background: $background;
    border-bottom: solid rgba(255, 255, 255, 0.06);
}

#monitor-status {
    height: 3;
    padding: 0 2;
    margin: 1 0;
    background: $surface;
}

.monitor-running {
    border-left: thick $success;
}

.monitor-stopped {
    border-left: thick $danger;
}

#monitor-log {
    height: 1fr;
    background: $background;
    border: none;
}

/* ---- Entry detail SIDE PANEL (was a modal) ---- */
#entry-detail-panel {
    dock: right;
    width: 40;
    height: 100%;
    padding: 1 2;
    background: $surface;
    border-left: solid rgba(255, 255, 255, 0.06);
    color: $text;
}

#entry-detail-panel.hidden {
    display: none;
}

#entry-detail-panel .modal-title {
    color: $text-strong;
    text-style: bold;
    margin: 0 0 1 0;
}

#entry-detail-panel .detail-row {
    height: auto;
    margin: 0 0 1 0;
}

#entry-detail-panel .detail-label {
    width: 15;
    color: $text-muted;
}

#entry-detail-panel .detail-value {
    width: 1fr;
    color: $text;
}

#entry-detail-panel .detail-changes {
    color: $text;
    margin: 1 0;
}

/* ---- Log browser layout (table + side panel) ---- */
#log-browser-container {
    layout: vertical;
    height: 1fr;
    width: 1fr;
}

#log-table-and-panel {
    layout: horizontal;
    height: 1fr;
    width: 1fr;
}

/* ---- Export dialog (centered modal, lighter chrome) ---- */
ExportDialog {
    align: center middle;
}

ExportDialog > Vertical {
    width: 60;
    height: auto;
    padding: 1 2;
    background: $background;
    border: round $primary 50%;
}

ExportDialog .modal-title {
    color: $text-strong;
    text-style: bold;
}

ExportDialog RadioSet {
    height: auto;
    margin: 1 0;
    background: $background;
}

ExportDialog Input {
    width: 100%;
    margin: 1 0;
    background: $surface;
    border: none;
    color: $text;
}

/* ---- Settings ---- */
.settings-section {
    height: auto;
    padding: 1 2;
    margin: 1 0;
    background: $surface;
    border-left: thick $primary;
}

.settings-row {
    height: auto;
    margin: 0 0 1 0;
}

.settings-label {
    width: 22;
    color: $text-muted;
}

.settings-value {
    width: 1fr;
    color: $text;
}

/* ---- Alerts management ---- */
.rule-card {
    height: auto;
    padding: 1 2;
    margin: 1 0;
    background: $surface;
    border-left: thick #6e7480;
}

.rule-card.rule-enabled {
    border-left: thick $success;
}

.rule-card.rule-disabled {
    border-left: thick #6e7480;
}

/* ---- Help overlay ---- */
HelpScreen {
    align: center middle;
}

#help-overlay {
    width: 70;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: $background;
    border: round $primary 50%;
}

.help-title {
    color: $text-strong;
    text-style: bold;
    margin: 0 0 1 0;
}

.help-section {
    color: $text-muted;
    margin: 1 0 0 0;
}

.help-key {
    width: 10;
    color: $primary;
    text-style: bold;
}

.help-description {
    width: 1fr;
    color: $text;
}

/* ---- Pagination ---- */
#pagination {
    height: 3;
    dock: bottom;
    padding: 0 1;
    background: $background;
    border-top: solid rgba(255, 255, 255, 0.06);
}

#pagination Button {
    margin: 0 1 0 0;
    background: $surface;
    color: $text;
    border: none;
    text-style: none;
}

#pagination Label {
    padding: 1;
    color: $text-muted;
}

/* ---- Loading indicator ---- */
.loading {
    align: center middle;
    height: 100%;
    width: 100%;
}

LoadingIndicator {
    color: $primary;
}

/* ---- Status indicators (used in dashboard/connection text) ---- */
.status-connected     { color: $success; }
.status-disconnected  { color: $danger; }
.status-warning       { color: $warning; }
